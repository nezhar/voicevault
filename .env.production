# Production Environment Template
# Copy this file to .env and configure with your actual values

# Container Registry and Versioning
# Published images are available as ghcr.io/nezhar/voicevault-ui, -api, and -worker.
REGISTRY=ghcr.io/nezhar/
VERSION=latest

# Authentication (Required for production)
# AUTH_MODE: token | oidc
#   token -> a single shared ACCESS_TOKEN gates the whole app
#   oidc  -> SSO via any OpenID Connect provider (ADFS, Keycloak, Entra ID, ...)
#            with per-user identities and Projects sharing — see docs/oidc-setup.md
AUTH_MODE=token
ACCESS_TOKEN=your-secure-token-here-make-it-long-and-random

# OIDC (required when AUTH_MODE=oidc) — see docs/oidc-setup.md
OIDC_DISCOVERY_URL=            # e.g. https://fs.example.com/adfs/.well-known/openid-configuration
OIDC_CLIENT_ID=voicevault
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_CLAIM_SUBJECT=sub
OIDC_CLAIM_EMAIL=email         # ADFS: upn
OIDC_CLAIM_NAME=name           # ADFS: unique_name
PUBLIC_BASE_URL=               # e.g. https://voicevault.example.com — must match the redirect URI registered at the IdP
INITIAL_OWNER_EMAIL=           # this user takes over pre-existing entries on first login

# Sessions & CORS (AUTH_MODE=oidc)
SESSION_SECRET=                # generate: openssl rand -hex 32
SESSION_LIFETIME_HOURS=12
SESSION_COOKIE_SECURE=true     # production runs behind HTTPS
CORS_ORIGINS=                  # e.g. https://voicevault.example.com

# Admin dashboard access (AUTH_MODE=oidc only).
# Comma-separated email addresses; matching users get /admin and /api/admin.
# Everyone else — and every request in none/token mode — receives 404.
# Changing this requires an API restart.
ADMIN_EMAILS=

# Database Configuration (Required)
POSTGRES_HOST=your-database-host
POSTGRES_PORT=5432
POSTGRES_DB=voicevault
POSTGRES_USER=voicevault_user
POSTGRES_PASSWORD=your-secure-database-password

# API Configuration
API_PORT=8000
UI_PORT=3000

# API Keys
GROQ_API_KEY=your-groq-api-key-here  # Whisper transcription (ASR_PROVIDER=groq)
# LLM_API_KEY (also required for hosted providers) is set below under LLM Configuration

# LLM Configuration - any OpenAI-compatible chat completions endpoint
# e.g. https://api.groq.com/openai/v1 (Groq) or https://api.cerebras.ai/v1 (Cerebras).
# A local Ollama service added to Docker Compose would be http://ollama:11434/v1.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
# Optional: reply token limit (default 1024 for chat, 512 for summaries).
# Reasoning models (Qwen3, DeepSeek-R1, ...) think within the same limit and
# return no answer when it is too low - use e.g. 8192 for them.
LLM_MAX_TOKENS=
# Optional: JSON object merged into every request body, e.g. to switch off
# thinking for Qwen3 served by vLLM/SGLang:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=
# Optional: seconds to wait for a complete reply, thinking included (default 120).
# Above 180 MCP tool calls give up first; above 300 raise nginx's proxy_read_timeout too.
LLM_TIMEOUT=

# ASR Configuration
ASR_PROVIDER=groq
ASR_MODEL=whisper-large-v3-turbo

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=524288000

# S3 Configuration (Required - works with any S3-compatible provider)
# Examples:
# Vultr: https://ewr1.vultrobjects.com
# AWS: https://s3.amazonaws.com
# DigitalOcean: https://nyc3.digitaloceanspaces.com
S3_ENDPOINT_URL=your-s3-endpoint-url
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=voicevault

# Processing Configuration
PROCESSING_TIMEOUT=3600

# Worker Configuration
WORKER_INTERVAL=10
BATCH_SIZE=5

# Development Settings
DEBUG=false
LOG_LEVEL=INFO
