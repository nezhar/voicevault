# Container Registry and Versioning
# Published images are available as ghcr.io/nezhar/voicevault-ui, -api, and -worker.
# Leave REGISTRY empty when you want Docker Compose to build local image names.
REGISTRY=ghcr.io/nezhar/
VERSION=latest

# Database Configuration
POSTGRES_HOST=your_database_host
POSTGRES_PORT=5432
POSTGRES_DB=voicevault
POSTGRES_USER=voicevault_user
POSTGRES_PASSWORD=your_secure_password_here

# API Configuration
API_PORT=8000
UI_PORT=3000
API_URL=http://api:8000  # UI nginx proxy target (use http://localhost:8000 if API runs outside Docker)
NGINX_LISTEN=80  # Nginx listen address:port (e.g., 80, 0.0.0.0:80, 127.0.0.1:8080)

# API Keys (Required for production)
GROQ_API_KEY=your_groq_api_key_here  # Whisper transcription (ASR_PROVIDER=groq)
# LLM_API_KEY (also required for hosted providers) is set below under LLM Configuration

# Authentication
# AUTH_MODE: none | token | oidc
#   unset  -> derived: 'token' when ACCESS_TOKEN is set, otherwise 'none'
#   none   -> no login (development)
#   token  -> single shared ACCESS_TOKEN (previous behavior)
#   oidc   -> SSO via any OpenID Connect provider (ADFS, Keycloak, Entra ID, ...)
AUTH_MODE=
ACCESS_TOKEN=

# OIDC (required when AUTH_MODE=oidc) — see docs/oidc-setup.md
OIDC_DISCOVERY_URL=            # e.g. https://fs.example.com/adfs/.well-known/openid-configuration
OIDC_CLIENT_ID=voicevault
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_CLAIM_SUBJECT=sub         # ADFS: employeeID
OIDC_CLAIM_EMAIL=email         # ADFS: upn
OIDC_CLAIM_NAME=name           # fallback when the given/family claims are absent
OIDC_CLAIM_GIVEN_NAME=given_name   # ADFS: firstname
OIDC_CLAIM_FAMILY_NAME=family_name # ADFS: lastname
PUBLIC_BASE_URL=               # e.g. https://voicevault.example.com
INITIAL_OWNER_EMAIL=           # this user takes over pre-existing entries on first login

# Sessions & CORS (AUTH_MODE=oidc)
SESSION_SECRET=                # generate: openssl rand -hex 32
SESSION_LIFETIME_HOURS=12
SESSION_COOKIE_SECURE=true     # false only for local HTTP development
CORS_ORIGINS=http://localhost:3000

# Admin dashboard access.
# In none/token mode the single shared local user is the admin, so /admin works
# without setting anything here (it aggregates data that user can already read).
# In oidc mode, list the admins: comma-separated email addresses; matching users
# get /admin and /api/admin, everyone else receives 404.
# Changing this requires an API restart.
ADMIN_EMAILS=

# Maintenance
# Fill in missing entry consumption metrics (size/duration/words) on API
# startup, in the background. Costs one S3 HEAD per entry with an unknown size;
# set false to run app.scripts.backfill_entry_metrics by hand instead.
BACKFILL_METRICS_ON_STARTUP=true

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=524288000

# S3 Configuration (Works with any S3-compatible provider)
# Examples:
# AWS: https://s3.amazonaws.com
# DigitalOcean: https://nyc3.digitaloceanspaces.com
# Vultr: https://ewr1.vultrobjects.com
# MinIO (local): http://minio:9000
S3_ENDPOINT_URL=your_s3_endpoint_url
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=voicevault

# Host ports the local MinIO container publishes (compose.yml only).
# Leave these COMMENTED OUT unless you hit a conflict -- compose already
# defaults them to 9000 and 9001, and setting them to those same values here
# just re-pins the ports you would be trying to escape.
#
# Uncomment and move BOTH if startup fails with
# "failed to bind host port 0.0.0.0:9000". They are a pair: setting only
# MINIO_PORT=9001 collides with the console and Docker then reports
# "port is already allocated".
#
# These affect HOST access only. S3_ENDPOINT_URL must stay http://minio:9000,
# because the API and workers reach MinIO by service name inside the Docker
# network, where the port is always 9000.
#MINIO_PORT=9010
#MINIO_CONSOLE_PORT=9011

# Processing Configuration
PROCESSING_TIMEOUT=3600

# ASR Configuration
ASR_PROVIDER=groq  # Options: groq, whisper_asr
ASR_MODEL=whisper-large-v3-turbo  # Groq models: whisper-large-v3, whisper-large-v3-turbo

# Whisper ASR Webservice Configuration (only if ASR_PROVIDER=whisper_asr)
WHISPER_ASR_URL=http://localhost:9000  # URL of whisper-asr-webservice instance

# LLM Configuration - any OpenAI-compatible chat completions endpoint
# Known base URLs:
#   Groq      https://api.groq.com/openai/v1               model e.g. llama-3.3-70b-versatile
#   Cerebras  https://api.cerebras.ai/v1                   model e.g. llama-3.3-70b
#   Nebius    https://api.tokenfactory.nebius.com/v1       model e.g. meta-llama/Meta-Llama-3.1-70B-Instruct
#   OpenAI    https://api.openai.com/v1                    model e.g. gpt-4o-mini
#   Ollama    http://localhost:11434/v1                    any pulled model, no key needed
#             (use http://host.docker.internal:11434/v1 when VoiceVault runs in Docker)
LLM_BASE_URL=https://api.groq.com/openai/v1
# required for hosted providers (Groq, Cerebras, Nebius, OpenAI); if you stay on
# Groq for chat you can reuse the same value as GROQ_API_KEY above. Leave empty
# for keyless local servers such as Ollama.
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Optional: reply token limit (default 1024 for chat, 512 for summaries).
# Reasoning models (Qwen3, DeepSeek-R1, ...) think within the same limit and
# return no answer when it is too low - use e.g. 8192 for them.
LLM_MAX_TOKENS=
# Optional: JSON object merged into every request body, e.g. to switch off
# thinking for Qwen3 served by vLLM/SGLang:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY=

# Worker Configuration
WORKER_INTERVAL=10
BATCH_SIZE=5

# Development Settings
DEBUG=true
LOG_LEVEL=INFO

# MCP: PAT-only Streamable HTTP at /mcp (see docs/mcp.md)
MCP_ENABLED=false
# PUBLIC_BASE_URL host is also allowed automatically.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
