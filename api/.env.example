# Database
DATABASE_URL=sqlite:///./voicevault.db

# LLM Configuration - any OpenAI-compatible endpoint (see ../.env.example for known base URLs)
LLM_BASE_URL=https://api.groq.com/openai/v1
# required for hosted providers (reuse GROQ_API_KEY for Groq); empty for keyless local servers such as Ollama
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=524288000

# Processing
PROCESSING_TIMEOUT=3600
